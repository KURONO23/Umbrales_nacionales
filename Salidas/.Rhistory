factor_piso_prob_corte <- 3
############################################################
# FUNCIONES AUXILIARES
############################################################
limpiar_id <- function(x) {
sub("\\.0$", "", trimws(as.character(x)))
}
sigmoid_seguro <- function(eta) {
eta <- pmin(pmax(eta, -700), 700)
1 / (1 + exp(-eta))
}
extent_es_lonlat_valido <- function(r) {
e <- terra::ext(r)
is.finite(e$xmin) && is.finite(e$xmax) &&
is.finite(e$ymin) && is.finite(e$ymax) &&
e$xmin >= -180 && e$xmax <= 180 &&
e$ymin >= -90 && e$ymax <= 90 &&
e$xmin < e$xmax && e$ymin < e$ymax &&
!(abs(e$xmin) < 1e-9 && abs(e$ymin) < 1e-9)
}
corregir_raster_operativo <- function(r, etiqueta = "raster") {
if (is.na(terra::crs(r)) || terra::crs(r) == "") {
cat("Asignando CRS EPSG:4326 a", etiqueta, "porque estaba vacio.\n")
terra::crs(r) <- crs_pisco
}
if (!extent_es_lonlat_valido(r)) {
cat("Corrigiendo extent de", etiqueta, "a extent PISCO completo porque el extent no parece lon/lat valido.\n")
terra::ext(r) <- ext_pisco
terra::crs(r) <- crs_pisco
}
r
}
exportar_raster <- function(x, archivo) {
terra::writeRaster(x, archivo, overwrite = TRUE)
cat("Raster exportado:", archivo, "\n")
invisible(TRUE)
}
# Suma de los n dias anteriores a la columna col_hoy de la matriz M
# (filas = ciudades, columnas = dias). na.rm = FALSE: un dia sin dato deja
# el antecedente en NA en vez de contarlo como 0 mm.
sumar_antecedente <- function(M, col_hoy, n) {
if (is.na(n) || n <= 0 || col_hoy - n < 1) return(rep(NA_real_, nrow(M)))
rowSums(M[, (col_hoy - n):(col_hoy - 1), drop = FALSE], na.rm = FALSE)
}
antecedente_por_ciudad <- function(M, col_hoy, ventanas) {
out <- rep(NA_real_, nrow(M))
for (w in unique(ventanas[!is.na(ventanas)])) {
sel <- !is.na(ventanas) & ventanas == w
out[sel] <- sumar_antecedente(M, col_hoy, w)[sel]
}
out
}
############################################################
# 1) LEER PRONOSTICO GFS Y AGREGAR A DIARIO
############################################################
archivos_gfs <- list.files(dir_gfs, pattern = patron_gfs, full.names = FALSE)
if (length(archivos_gfs) == 0) {
stop("No se encontraron archivos pp_GFS_YYYYMMDD.nc en ", dir_gfs, ".")
}
fechas_emision <- as.Date(sub("^pp_GFS_(\\d{8})\\.nc$", "\\1", archivos_gfs), format = "%Y%m%d")
archivo_gfs   <- archivos_gfs[which.max(fechas_emision)]
fecha_emision <- max(fechas_emision)
cat("Pronostico GFS:", archivo_gfs, "- emision", format(fecha_emision), "\n")
desfase <- as.integer(Sys.Date() - fecha_emision)
if (desfase > max_desfase_gfs) {
msg <- paste0("La emision GFS (", format(fecha_emision), ") tiene ", desfase,
" dias de atraso respecto a la fecha del sistema; el maximo tolerado es ",
max_desfase_gfs, ".")
if (detener_si_desactualizado) stop(msg)
cat("ADVERTENCIA:", msg, "Se corre igual.\n")
}
# Lee un pp_GFS_YYYYMMDD.nc y lo devuelve en paso diario:
# list(r = SpatRaster con una capa por dia, dias = Date).
leer_gfs_diario <- function(archivo, fecha_em) {
r <- terra::rast(file.path(dir_gfs, archivo))
if (varname_gfs %in% terra::varnames(r)) r <- r[varname_gfs]
if (terra::is.lonlat(r)) terra::crs(r) <- crs_pisco
tt <- terra::time(r)
if (is.null(tt) || all(is.na(tt))) {
cat("ADVERTENCIA:", archivo, "no trae tiempo; se asumen pasos diarios desde la fecha de emision.\n")
dias_capa <- fecha_em + seq_len(terra::nlyr(r)) - 1
} else if (inherits(tt, "POSIXt")) {
dias_capa <- as.Date(tt, tz = tz_dia_gfs)
} else {
dias_capa <- as.Date(tt)
}
if (anyDuplicated(dias_capa)) {
# Pasos subdiarios: sumar por dia, descartando dias incompletos
# (tipicamente el primero y/o el ultimo del horizonte).
n_por_dia <- table(dias_capa)
n_completo <- max(n_por_dia)
dias_completos <- as.Date(names(n_por_dia)[n_por_dia == n_completo])
dias_incompletos <- as.Date(names(n_por_dia)[n_por_dia < n_completo])
if (length(dias_incompletos) > 0) {
cat("ADVERTENCIA: se descartan dias GFS incompletos de", archivo, ":",
paste(format(dias_incompletos), collapse = ", "), "\n")
}
sel <- dias_capa %in% dias_completos
indice <- factor(format(dias_capa[sel]), levels = format(sort(dias_completos)))
r <- terra::tapp(r[[which(sel)]], index = indice, fun = "sum", na.rm = FALSE)
dias <- sort(dias_completos)
cat(archivo, ": agregado a diario,", n_completo, "pasos por dia.\n")
} else {
ord <- order(dias_capa)
r <- r[[ord]]
dias <- dias_capa[ord]
cat(archivo, ": ya viene en paso diario.\n")
}
if (any(diff(dias) != 1)) {
stop("Los dias del pronostico GFS de ", archivo, " no son consecutivos: ",
paste(format(dias), collapse = ", "))
}
# Precipitacion negativa por interpolacion/redondeo -> 0
r <- terra::clamp(r, lower = 0, values = TRUE)
names(r) <- format(dias, "%Y-%m-%d")
list(r = r, dias = dias)
}
gfs_actual <- leer_gfs_diario(archivo_gfs, fecha_emision)
r_gfs <- gfs_actual$r
dias_gfs <- gfs_actual$dias
n_pron <- length(dias_gfs)
cat("Dias pronosticados:", n_pron, "(", format(min(dias_gfs)), "a", format(max(dias_gfs)), ")\n")
############################################################
# 2) ANTECEDENTE OBSERVADO (PISCO) Y REMUESTREO DE GFS
############################################################
if (!dir.exists(dir_pisco)) {
stop("No se pudo acceder al share PISCO: ", dir_pisco, ". Verificar conexion de red o permisos.")
}
archivos_pisco <- list.files(dir_pisco, pattern = patron_pisco, full.names = FALSE)
if (length(archivos_pisco) == 0) stop("No hay PISCO_Operativo*.tif en ", dir_pisco, ".")
fechas_pisco <- as.Date(sub("^PISCO_Operativo|\\.tif$", "", archivos_pisco))
# Geometria de referencia: el PISCO mas reciente del share.
pp_ref <- terra::rast(file.path(dir_pisco, archivos_pisco[which.max(fechas_pisco)]))[[1]]
pp_ref <- corregir_raster_operativo(pp_ref, etiqueta = "PISCO de referencia")
fecha_ini <- min(dias_gfs)
fechas_obs <- seq(fecha_ini - n_dias_ant, fecha_ini - 1, by = "day")
archivos_obs <- paste0("PISCO_Operativo", format(fechas_obs, "%Y-%m-%d"), ".tif")
presentes <- archivos_obs %in% archivos_pisco
cat("Antecedente PISCO disponible:", sum(presentes), "de", n_dias_ant,
"(", format(min(fechas_obs)), "a", format(max(fechas_obs)), ")\n")
if (!any(presentes)) {
stop("No hay ningun dia PISCO observado entre ", format(min(fechas_obs)),
" y ", format(max(fechas_obs)), ".")
}
capa_na <- pp_ref * NA
capas_obs <- lapply(seq_along(fechas_obs), function(k) {
if (!presentes[k]) return(capa_na)
r <- terra::rast(file.path(dir_pisco, archivos_obs[k]))[[1]]
r <- corregir_raster_operativo(r, etiqueta = archivos_obs[k])
if (!terra::compareGeom(r, pp_ref, stopOnError = FALSE)) {
stop("La geometria de ", archivos_obs[k], " no coincide con la del PISCO de referencia.")
}
r
})
fuente_obs <- ifelse(presentes, "PISCO", NA_character_)
# Relleno de dias PISCO faltantes con emisiones GFS anteriores.
# PISCO del dia D se publica el dia D+1 (~14:00), por lo que en la corrida
# de la manana siempre falta al menos el dia anterior al inicio del
# pronostico. Se usa el pronostico de ese dia de la emision GFS mas
# reciente que lo cubra (la de menor plazo).
if (!all(presentes) && rellenar_con_gfs_anterior) {
emisiones_prev <- data.frame(archivo = archivos_gfs, emision = fechas_emision) %>%
filter(emision < fecha_emision) %>%
arrange(desc(emision))
for (i in seq_len(nrow(emisiones_prev))) {
faltan_idx <- which(is.na(fuente_obs))
if (length(faltan_idx) == 0) break
g <- tryCatch(leer_gfs_diario(emisiones_prev$archivo[i], emisiones_prev$emision[i]),
error = function(e) {
cat("ADVERTENCIA: no se pudo leer", emisiones_prev$archivo[i], ":", conditionMessage(e), "\n")
NULL
})
if (is.null(g)) next
for (k in faltan_idx) {
j <- match(fechas_obs[k], g$dias)
if (is.na(j)) next
capas_obs[[k]] <- terra::resample(g$r[[j]], pp_ref, method = metodo_remuestreo)
fuente_obs[k] <- paste0("GFS_", format(emisiones_prev$emision[i], "%Y%m%d"))
}
}
}
rellenados <- which(!presentes & !is.na(fuente_obs))
if (length(rellenados) > 0) {
cat("Dias PISCO faltantes rellenados con GFS anterior:",
paste0(format(fechas_obs[rellenados]), " (", fuente_obs[rellenados], ")", collapse = ", "), "\n")
}
if (any(is.na(fuente_obs))) {
cat("ADVERTENCIA: dias sin PISCO ni GFS anterior:",
paste(format(fechas_obs[is.na(fuente_obs)]), collapse = ", "), ".",
"Quedan como NA: las ventanas que los incluyan tendran antecedente NA.\n")
}
pp_obs <- terra::rast(capas_obs)
cat("Remuestreando GFS a la grilla PISCO (", metodo_remuestreo, ")...\n")
pp_gfs <- terra::resample(r_gfs, pp_ref, method = metodo_remuestreo)
# Serie continua: n_dias_ant dias observados + n_pron dias pronosticados
serie <- c(pp_obs, pp_gfs)
fechas_serie <- c(fechas_obs, dias_gfs)
names(serie) <- format(fechas_serie, "%Y-%m-%d")
# Fuente de cada dia: "PISCO", "GFS_<emision>" (relleno o pronostico) o "NA"
fuente_serie <- c(ifelse(is.na(fuente_obs), "NA", fuente_obs),
rep(paste0("GFS_", format(fecha_emision, "%Y%m%d")), n_pron))
cat("Fuente de la serie:\n")
print(data.frame(fecha = format(fechas_serie), fuente = fuente_serie), row.names = FALSE)
############################################################
# 3) PARAMETROS DEL MODELO Y CONTROL DE CALIDAD
############################################################
res_eval_file <- file.path(dir_calibracion, "res_eval.rds")
if (!file.exists(res_eval_file)) {
stop("No existe ", res_eval_file, ". Ejecuta primero la calibracion (Umbrales4.R).")
}
res_eval <- readRDS(res_eval_file)
cuadro_ciudad <- res_eval$cuadro_ciudad %>% mutate(ciudad = limpiar_id(ciudad))
coef_log <- res_eval$coef_log %>% mutate(ciudad = limpiar_id(ciudad))
cat("Parametros cargados para", nrow(cuadro_ciudad), "IDs.\n")
diag_modelos <- res_eval$diagnostico_modelos %>%
mutate(id_modelo = limpiar_id(ciudad)) %>%
select(id_modelo, n_eventos_base, n_dias_base)
calidad_modelos <- cuadro_ciudad %>%
select(ciudad, id_modelo_vecino, mejor_ventana_op, umbral_op, mcc_op,
mejor_ventana_log, prob_corte) %>%
mutate(id_modelo = limpiar_id(id_modelo_vecino)) %>%
left_join(coef_log %>% select(ciudad, b1, b2), by = "ciudad") %>%
left_join(diag_modelos, by = "id_modelo") %>%
mutate(
frec_base = n_eventos_base / n_dias_base,
piso_prob_corte = factor_piso_prob_corte * frec_base,
tiene_eventos_min = !is.na(n_eventos_base) & n_eventos_base >= min_eventos_confiable,
calidad_op = case_when(
is.na(mejor_ventana_op) | is.na(umbral_op) | is.na(mcc_op) | mcc_op <= 0 ~ "sin_skill",
tiene_eventos_min & mcc_op > min_mcc_op_confiable ~ "confiable",
TRUE ~ "debil"
),
prob_corte_ef = pmax(prob_corte, piso_prob_corte, na.rm = TRUE),
calidad_log = case_when(
is.na(mejor_ventana_log) | is.na(b1) | b1 < 0 |
is.na(prob_corte) | prob_corte >= 1 | !(prob_corte_ef > 0) ~ "sin_skill",
tiene_eventos_min & !is.na(b2) & b2 >= 0 &
!is.na(piso_prob_corte) & prob_corte >= piso_prob_corte ~ "confiable",
TRUE ~ "debil"
)
)
cat("Calidad de los modelos (op):\n");  print(table(calidad_modelos$calidad_op))
cat("Calidad de los modelos (log):\n"); print(table(calidad_modelos$calidad_log))
cuadro_ciudad <- cuadro_ciudad %>%
left_join(calidad_modelos %>% select(ciudad, calidad_op, calidad_log, prob_corte_ef),
by = "ciudad") %>%
mutate(
prob_corte_orig = prob_corte,
prob_corte = ifelse(calidad_log == "sin_skill", NA_real_, prob_corte_ef),
umbral_op  = ifelse(calidad_op  == "sin_skill", NA_real_, umbral_op)
) %>%
select(-prob_corte_ef)
############################################################
# 4) GRILLA, CENTROIDES E IDS
############################################################
if (!file.exists(grilla_file)) stop("No existe grilla_file: ", grilla_file)
grilla <- terra::vect(grilla_file)
if (!(campo_id %in% names(grilla))) {
stop("grillaPISCO no tiene el campo '", campo_id, "'.")
}
grilla$ID_CIUDAD <- limpiar_id(terra::values(grilla)[[campo_id]])
centroides <- read.csv(centroides_file) %>%
mutate(
ID_CIUDAD = limpiar_id(.data[[campo_id]]),
x = as.numeric(.data[[x_col]]),
y = as.numeric(.data[[y_col]])
) %>%
filter(!is.na(ID_CIUDAD), !is.na(x), !is.na(y)) %>%
distinct(ID_CIUDAD, .keep_all = TRUE)
ids_comunes <- Reduce(intersect, list(unique(cuadro_ciudad$ciudad),
unique(grilla$ID_CIUDAD),
unique(centroides$ID_CIUDAD)))
cat("IDs comunes modelo-grilla-centroides:", length(ids_comunes), "\n")
if (length(ids_comunes) == 0) stop("No hay IDs coincidentes entre modelo, grilla y centroides.")
centroides <- centroides %>% filter(ID_CIUDAD %in% ids_comunes)
# Parametros alineados fila a fila con los centroides
params <- cuadro_ciudad %>%
filter(ciudad %in% ids_comunes) %>%
distinct(ciudad, .keep_all = TRUE) %>%
left_join(coef_log %>% distinct(ciudad, .keep_all = TRUE), by = "ciudad")
params <- params[match(centroides$ID_CIUDAD, params$ciudad), ]
pts <- terra::vect(centroides, geom = c("x", "y"), crs = crs_pisco, keepgeom = FALSE)
if (!terra::same.crs(pts, serie)) pts <- terra::project(pts, terra::crs(serie))
############################################################
# 5) EXTRAER SERIE EN CENTROIDES Y APLICAR MODELOS POR DIA
############################################################
cat("Extrayendo serie PISCO+GFS en", nrow(centroides), "centroides...\n")
M <- as.matrix(terra::extract(serie, pts, ID = FALSE))
colnames(M) <- names(serie)
aplicar_modelo_dia <- function(k) {
col_hoy <- n_dias_ant + k
pp <- M[, col_hoy]
ant_log <- antecedente_por_ciudad(M, col_hoy, params$mejor_ventana_log)
ant_op  <- antecedente_por_ciudad(M, col_hoy, params$mejor_ventana_op)
eta  <- params$b0 + params$b1 * pp + params$b2 * ant_log
prob <- ifelse(is.finite(eta), sigmoid_seguro(eta), NA_real_)
prob[params$calidad_log %in% "sin_skill"] <- NA_real_
evento_log <- ifelse(is.na(prob) | is.na(params$prob_corte), NA_integer_,
as.integer(prob >= params$prob_corte))
Iop <- pp + peso_ant * ant_op
evento_op <- ifelse(is.na(Iop) | is.na(params$umbral_op), NA_integer_,
as.integer(Iop >= params$umbral_op))
# Cuantos dias de cada ventana cumplen una condicion de la serie
# (PISCO observado, o relleno con GFS de una emision anterior).
n_en_ventana <- function(w, marca) {
vapply(w, function(wi) {
if (is.na(wi)) return(NA_integer_)
as.integer(sum(marca[(col_hoy - wi):(col_hoy - 1)]))
}, integer(1))
}
es_pisco   <- fuente_serie == "PISCO"
es_relleno <- seq_along(fuente_serie) <= n_dias_ant & fuente_serie != "PISCO" & fuente_serie != "NA"
tabla <- data.frame(
ciudad = params$ciudad,
fecha_emision = fecha_emision,
fecha = dias_gfs[k],
plazo = k,
pp = round(pp, 1),
ant_log = round(ant_log, 1),
ant_op = round(ant_op, 1),
ventana_log = params$mejor_ventana_log,
ventana_op = params$mejor_ventana_op,
dias_obs_ant_log = n_en_ventana(params$mejor_ventana_log, es_pisco),
dias_obs_ant_op = n_en_ventana(params$mejor_ventana_op, es_pisco),
dias_relleno_ant_log = n_en_ventana(params$mejor_ventana_log, es_relleno),
dias_relleno_ant_op = n_en_ventana(params$mejor_ventana_op, es_relleno),
prob = round(prob, 3),
prob_corte = round(params$prob_corte, 3),
evento_log = evento_log,
Iop = round(Iop, 1),
umbral_op = round(params$umbral_op, 1),
evento_op = evento_op,
prob_corte_orig = round(params$prob_corte_orig, 3),
calidad_log = params$calidad_log,
calidad_op = params$calidad_op
)
# Nivel de alerta (igual que 02): alta = 2 metodos, media = 1, baja = 0,
# NA = ningun metodo disponible.
ev <- cbind(tabla$evento_log, tabla$evento_op)
n_alertas <- rowSums(ev == 1, na.rm = TRUE)
n_disp <- rowSums(!is.na(ev))
tabla$nivel_alerta_cod <- ifelse(n_disp == 0, NA_integer_, as.integer(n_alertas))
tabla$nivel_alerta <- c("baja", "media", "alta")[tabla$nivel_alerta_cod + 1]
tabla
}
tablas <- lapply(seq_len(n_pron), aplicar_modelo_dia)
tabla_larga <- bind_rows(tablas)
diag <- tabla_larga %>%
group_by(fecha, plazo) %>%
summarise(
n = n(),
n_pp_valido = sum(is.finite(pp)),
pp_media = round(mean(pp, na.rm = TRUE), 2),
pp_max = max(pp, na.rm = TRUE),
n_prob_valido = sum(is.finite(prob)),
n_evento_log_1 = sum(evento_log == 1, na.rm = TRUE),
n_evento_op_1 = sum(evento_op == 1, na.rm = TRUE),
n_alerta_alta = sum(nivel_alerta == "alta", na.rm = TRUE),
n_alerta_media = sum(nivel_alerta == "media", na.rm = TRUE),
n_alerta_baja = sum(nivel_alerta == "baja", na.rm = TRUE),
n_alerta_na = sum(is.na(nivel_alerta)),
.groups = "drop"
) %>%
as.data.frame()
cat("\nDiagnostico por dia de pronostico:\n")
print(diag)
if (all(diag$n_pp_valido == 0)) {
stop("Toda la precipitacion GFS extraida salio NA. Revisar extent/CRS de ", archivo_gfs, ".")
}
if (any(diag$n_pp_valido == 0)) {
cat("ADVERTENCIA: dias GFS sin ningun dato valido:",
paste(format(diag$fecha[diag$n_pp_valido == 0]), collapse = ", "), "\n")
}
# Resumen del horizonte por ciudad
resumen_horizonte <- tabla_larga %>%
group_by(ciudad) %>%
summarise(
nivel_max_cod = if (all(is.na(nivel_alerta_cod))) NA_integer_ else max(nivel_alerta_cod, na.rm = TRUE),
fecha_nivel_max = if (all(is.na(nivel_alerta_cod))) as.Date(NA) else
min(fecha[!is.na(nivel_alerta_cod) & nivel_alerta_cod == max(nivel_alerta_cod, na.rm = TRUE)]),
primer_dia_alta = if (any(nivel_alerta_cod == 2, na.rm = TRUE))
min(fecha[!is.na(nivel_alerta_cod) & nivel_alerta_cod == 2]) else as.Date(NA),
n_dias_alta = sum(nivel_alerta_cod == 2, na.rm = TRUE),
n_dias_media = sum(nivel_alerta_cod == 1, na.rm = TRUE),
prob_max = if (all(is.na(prob))) NA_real_ else max(prob, na.rm = TRUE),
pp_acum = round(sum(pp, na.rm = FALSE), 1),
.groups = "drop"
) %>%
mutate(
nivel_max = c("baja", "media", "alta")[nivel_max_cod + 1],
fecha_emision = fecha_emision
) %>%
as.data.frame()
cat("\nNivel maximo en el horizonte:\n")
print(table(resumen_horizonte$nivel_max, useNA = "ifany"))
############################################################
# 6) EXPORTAR
############################################################
# Limpiar salidas previas; si algun archivo queda bloqueado (abierto en
# QGIS, el Explorador, etc.) se detiene con un mensaje claro.
cat("\nLimpiando carpeta de salidas:", dir_salidas, "...\n")
previos <- list.files(dir_salidas, full.names = TRUE, recursive = TRUE)
if (length(previos) > 0) {
unlink(previos, recursive = TRUE, force = TRUE)
bloqueados <- previos[file.exists(previos)]
if (length(bloqueados) > 0) {
stop("No se pudieron borrar (probablemente estan abiertos en otro programa): ",
paste(basename(bloqueados), collapse = ", "))
}
}
suf_em <- format(fecha_emision, "%Y-%m-%d")
write.csv(tabla_larga,
file.path(dir_salidas, paste0("pronostico_prob_grillaPISCO_emision_", suf_em, ".csv")),
row.names = FALSE)
write.csv(resumen_horizonte,
file.path(dir_salidas, paste0("resumen_horizonte_grillaPISCO_emision_", suf_em, ".csv")),
row.names = FALSE)
write.csv(diag,
file.path(dir_salidas, paste0("diagnostico_pronostico_emision_", suf_em, ".csv")),
row.names = FALSE)
# Raster indice de filas de la grilla: se rasteriza una sola vez y despues
# cada variable se pinta por consulta (mismo resultado que rasterizar campo
# por campo, mucho mas rapido para 10 dias x varias variables).
grilla_proj <- grilla
if (!terra::same.crs(grilla_proj, crs_pisco)) grilla_proj <- terra::project(grilla_proj, crs_pisco)
grilla_proj$idx_fila <- seq_len(nrow(grilla_proj))
r_template <- terra::rast(ext_pisco, resolution = res_pisco, crs = crs_pisco)
r_idx <- terra::rasterize(grilla_proj, r_template, field = "idx_fila", background = NA)
v_idx <- terra::values(r_idx)[, 1]
raster_desde_tabla <- function(tabla, campo) {
val_fila <- tabla[[campo]][match(grilla$ID_CIUDAD, tabla$ciudad)]
r <- r_idx
terra::values(r) <- as.numeric(val_fila[v_idx])
r
}
variables_dia <- c(prob = "prob", evento_log = "evento_log", evento_op = "evento_op",
pp = "pp", nivel_alerta = "nivel_alerta_cod")
stacks <- lapply(names(variables_dia), function(v) {
s <- terra::rast(lapply(tablas, raster_desde_tabla, campo = variables_dia[[v]]))
names(s) <- format(dias_gfs, "%Y-%m-%d")
terra::time(s) <- dias_gfs
s
})
names(stacks) <- names(variables_dia)
# Un NetCDF por variable con todos los dias del pronostico (dimension tiempo)
meta_nc <- list(
prob         = c("Probabilidad pronosticada (modelo logistico)", ""),
evento_log   = c("Evento pronosticado por el modelo logistico (0/1)", ""),
evento_op    = c("Evento pronosticado por el indice operativo (0/1)", ""),
pp           = c("Precipitacion GFS remuestreada a la grilla PISCO", "mm"),
nivel_alerta = c("Nivel de alerta pronosticado (0 baja, 1 media, 2 alta)", "")
)
for (v in names(stacks)) {
archivo_nc <- file.path(dir_salidas, paste0(v, "_GFS_grillaPISCO_emision_", suf_em, ".nc"))
terra::writeCDF(stacks[[v]], archivo_nc,
varname = v, longname = meta_nc[[v]][1], unit = meta_nc[[v]][2],
overwrite = TRUE)
cat("NetCDF exportado:", archivo_nc, "(", terra::nlyr(stacks[[v]]), "dias )\n")
}
# Nivel maximo del horizonte: 0 = baja, 1 = media, 2 = alta, NA = sin metodo
exportar_raster(raster_desde_tabla(resumen_horizonte, "nivel_max_cod"),
file.path(dir_salidas, paste0("nivel_max_GFS_grillaPISCO_emision_", suf_em, ".tif")))
# NetCDF de la serie de precipitacion usada (PISCO observado + GFS remuestreado)
serie_nc <- serie
terra::time(serie_nc) <- fechas_serie
terra::writeCDF(serie_nc,
file.path(dir_salidas, paste0("serie_PISCO_GFS_emision_", suf_em, ".nc")),
varname = "pp",
longname = paste0("Precipitacion diaria; fuente por dia: ",
paste0(format(fechas_serie, "%Y-%m-%d"), "=", fuente_serie,
collapse = ", ")),
unit = "mm", overwrite = TRUE)
# GeoPackage: grilla completa con resumen del horizonte y nivel por dia
grilla_out <- grilla
m <- match(grilla_out$ID_CIUDAD, resumen_horizonte$ciudad)
grilla_out$nivel_max        <- resumen_horizonte$nivel_max[m]
grilla_out$nivel_max_cod    <- resumen_horizonte$nivel_max_cod[m]
grilla_out$fecha_nivel_max  <- format(resumen_horizonte$fecha_nivel_max[m])
grilla_out$primer_dia_alta  <- format(resumen_horizonte$primer_dia_alta[m])
grilla_out$n_dias_alta      <- resumen_horizonte$n_dias_alta[m]
grilla_out$n_dias_media     <- resumen_horizonte$n_dias_media[m]
grilla_out$prob_max         <- resumen_horizonte$prob_max[m]
grilla_out$pp_acum          <- resumen_horizonte$pp_acum[m]
for (k in seq_len(n_pron)) {
campo <- paste0("nivel_", format(dias_gfs[k], "%Y%m%d"))
grilla_out[[campo]] <- tablas[[k]]$nivel_alerta_cod[match(grilla_out$ID_CIUDAD, tablas[[k]]$ciudad)]
}
terra::writeVector(grilla_out,
file.path(dir_salidas, paste0("grillaPISCO_pronostico_emision_", suf_em, ".gpkg")),
overwrite = TRUE)
############################################################
# 7) BORRAR PRONOSTICOS GFS ANTERIORES
############################################################
# Se hace al final, solo si la corrida termino bien: si algo falla, los
# .nc anteriores quedan disponibles. Se conservan las emisiones de los
# ultimos dias_retencion_gfs dias para rellenar los dias PISCO aun no
# publicados en las proximas corridas.
gfs_viejos <- archivos_gfs[fechas_emision < fecha_emision - dias_retencion_gfs]
if (length(gfs_viejos) > 0) {
ok <- file.remove(file.path(dir_gfs, gfs_viejos))
cat("Borrados", sum(ok), "pronostico(s) GFS anterior(es) de", dir_gfs, ":",
paste(gfs_viejos[ok], collapse = ", "), "\n")
if (!all(ok)) {
cat("ADVERTENCIA: no se pudieron borrar:", paste(gfs_viejos[!ok], collapse = ", "), "\n")
}
}
cat("\nProceso de pronostico GFS terminado. Emision", suf_em, "- dias",
format(min(dias_gfs)), "a", format(max(dias_gfs)), "\n")
setwd("D:/UmbralesUrbanos/UrbanNuna/PISCO_op/SalidasGFS")
p<- terra::rast("nivel_alerta_GFS_grillaPISCO_emision_2026-11-04.nc")
plot(p[[1]])
plot(p[[2]])
